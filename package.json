{
  "name": "tuezday",
  "private": true,
  "version": "0.0.1",
  "description": "Tuezday — AI-powered GTM orchestration platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n renderer,api,web,worker -c cyan,blue,magenta,green \"npm run dev -w apps/renderer\" \"npm run dev -w apps/api\" \"npm run dev -w apps/web\" \"npm run dev -w apps/worker\"",
    "dev:app": "concurrently -n api,web -c blue,magenta \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "test": "vitest run",
    "test:desktop": "playwright test --config=playwright.config.ts",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "eval": "tsx apps/api/scripts/eval-golden.ts",
    "eval:record": "tsx apps/api/scripts/eval-golden.ts --record",
    "evidence:migrate": "tsx apps/api/src/evidence/migrate.ts",
    "evidence:parity": "tsx apps/api/scripts/evidence-parity.ts",
    "postgres:up": "docker compose -f infra/postgres/docker-compose.yml up -d --wait",
    "postgres:down": "docker compose -f infra/postgres/docker-compose.yml down -v",
    "db:migrate-to-postgres": "tsx apps/api/scripts/sqlite-to-postgres.ts",
    "opendesign:up": "docker compose --env-file .env -f infra/open-design/compose.yaml up -d",
    "opendesign:down": "docker compose -f infra/open-design/compose.yaml down",
    "nango:up": "docker compose --env-file .env -f infra/nango/compose.yaml up -d",
    "nango:down": "docker compose -f infra/nango/compose.yaml down"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.1.0",
    "simple-icons": "^16.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
