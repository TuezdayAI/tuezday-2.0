# Copy to .env (gitignored) and fill in. The API loads this at startup.
GEMINI_API_KEY=
# Optional, defaults to gemini-2.5-flash
GEMINI_MODEL=
# Cheap-tier model for triage/matching/classification steps (Sprint 59 routing);
# defaults to gemini-2.5-flash-lite. Frontier tier stays GEMINI_MODEL.
GEMINI_MODEL_CHEAP=
# Embeddings for the native evidence store (Sprint 47); defaults to gemini-embedding-001.
GEMINI_EMBED_MODEL=

# R2R was retired at Sprint 47 — the evidence store is native (SQLite FTS5 +
# sqlite-vec) and no running deployment needs this. It is read only by the
# one-time `npm run evidence:migrate` script (migrating a pre-Sprint-47
# workspace off a still-running R2R) and by `npm run evidence:parity` (a
# manual R2R-vs-native comparison gate). Leave unset unless you are running
# one of those two scripts against a live R2R instance; defaults to
# http://localhost:7272.
R2R_BASE_URL=

# LLM provider flexibility (Sprint 41 Part 1)
# Primary provider: gemini (default) | openrouter. The other becomes automatic
# fallback if its key is set — a provider outage degrades instead of failing.
LLM_PROVIDER=
OPENROUTER_API_KEY=
# Optional, defaults to google/gemini-2.5-flash (same family, different pipe)
OPENROUTER_MODEL=
# Cheap-tier model on OpenRouter; defaults to google/gemini-2.5-flash-lite.
OPENROUTER_MODEL_CHEAP=

# Google Auth (Sprint 36): Create an OAuth 2.0 Web application at console.cloud.google.com
# Set Authorized redirect URIs to: http://localhost:3000/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback URL Google redirects back to after login; must match an Authorized
# redirect URI on the OAuth app above. Defaults to
# http://localhost:3000/login/google/callback — only needs overriding once the
# app is served from somewhere other than localhost:3000. # production only
GOOGLE_REDIRECT_URI=

# Connector fabric (Sprint 12): self-hosted Nango, brought up with
# `npm run nango:up` (infra/). Every OAuth-connected provider below (Reddit,
# LinkedIn, X, Instagram, Gmail) proxies through it.
# NANGO_BASE_URL: origin the API calls server-side for connector requests;
# defaults to http://localhost:3050.
# NANGO_PUBLIC_URL: origin the browser is redirected to for the OAuth popup;
# falls back to NANGO_BASE_URL, then http://localhost:3050. Set this
# separately from NANGO_BASE_URL whenever the API reaches Nango over a
# different address than the browser can (e.g. a container-internal hostname
# vs. a public one). # production only
# NANGO_SECRET_KEY: the Nango instance's API secret (infra/nango/compose.yaml).
NANGO_BASE_URL=
NANGO_PUBLIC_URL=
NANGO_SECRET_KEY=

# Social publishing (Sprint 17): Reddit OAuth app credentials. Create the app
# at https://www.reddit.com/prefs/apps (type "web app", redirect uri
# http://localhost:3050/oauth/callback) — the Reddit card on the Integrations
# page becomes connectable once these are set.
# Connected discovery (Sprint 46) also needs the `read` scope; it is requested
# automatically, but Reddit accounts connected before Sprint 46 must be
# disconnected/reconnected once to pick it up.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Connect social (Sprint 25): LinkedIn / X / Instagram OAuth apps. Each card on
# the Integrations page stays "needs OAuth app" until BOTH of its vars are set.
# For every app, register the Nango callback URL
# http://localhost:3050/oauth/callback as the redirect/callback URI.
#
# LinkedIn — https://www.linkedin.com/developers/apps : add the "Sign In with
# LinkedIn using OpenID Connect" + "Share on LinkedIn" products (scopes:
# openid, profile, email, w_member_social).
# Connected discovery (Sprint 46) additionally requests r_member_social to
# read member posts — LinkedIn grants it only through Community Management API
# app approval, so without it LinkedIn discovery sources show a clear
# "permission required" error while the rest of discovery keeps running.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional six-digit LinkedIn Marketing API version; defaults to 202607.
# LINKEDIN_API_VERSION=202607
# Enable only after LinkedIn approves Community Management access. Existing
# LinkedIn accounts must reconnect to grant the two added read scopes.
# LINKEDIN_COMMUNITY_APPROVED=false
# X (Twitter) — https://developer.x.com : an OAuth 2.0 app with tweet.read,
# tweet.write, users.read, dm.read, dm.write, offline.access. Use the OAuth 2.0
# Client ID / Client Secret (not the API key/secret).
# Connected discovery (Sprint 46) also requests list.read for X list-timeline
# sources; X accounts connected before Sprint 46 must be
# disconnected/reconnected once to pick it up. X search/timeline reading works
# within your X API plan's rate limits — sources back off automatically on 429.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Instagram — a direct Instagram Login app for a professional Business/Creator
# account. Configure the Nango "instagram" provider with the same client id and
# secret and request instagram_business_basic plus
# instagram_business_content_publish. OAuth completion binds that one account.
# Publishing and discovery use only its own media; competitor, hashtag, and
# Threads access are not supported. Existing Facebook Login/Page-backed rows
# show reconnect_required and must reconnect through direct Instagram Login.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Gmail mailbox (Sprint 47): a Google Cloud OAuth 2.0 Web application with the
# Gmail API enabled and scopes gmail.send + gmail.readonly. Register the Nango
# callback URL http://localhost:3050/oauth/callback as the redirect URI.
# "Testing" publishing status works for the founder's own account; app
# verification is needed before customer accounts can connect.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Runtime mode (DEP-1). Unset (or anything other than exactly "production")
# behaves like today's local dev/test — the fail-fast production env check
# below is a no-op, and Fastify/Next stay in their default non-production
# mode. Production containers MUST set this to exactly "production", or none
# of the boot-time validation on this branch ever runs.
NODE_ENV=

# API server runtime (DEP-1). Sensible defaults everywhere, so none of these
# need to be set for local dev.
# TUEZDAY_DB: SQLite file path; defaults to tuezday.db, resolved relative to
# the process's current working directory — that happens to be apps/api only
# because `npm run -w apps/api` sets it that way. A container's WORKDIR will
# usually differ. Production sets this to a mounted volume's absolute path so
# the database survives container restarts/redeploys; NODE_ENV=production
# refuses to boot if this is unset (a cwd-relative path in a container is
# almost never what you want). Leaving this line blank is treated the same as
# leaving it out — it is never passed through as an empty path, which would
# otherwise open a throwaway in-memory database that discards all data on
# restart.
# PORT: API listen port; defaults to 3001. Leaving this line blank is treated
# the same as leaving it out, not as 0.
# HOST: bind address; defaults to 127.0.0.1 so a locally started API isn't
# reachable from outside the machine. A container sets this to 0.0.0.0 so its
# reverse proxy can reach the process. # production only
# WEB_ORIGIN: comma-separated list of allowed browser origins for CORS. Each
# entry must include the scheme and no path, e.g. https://app.example.com —
# not app.example.com or https://app.example.com/. Unset reflects any origin
# (today's open default) — set this to lock the API down to the deployed web
# app's origin(s); NODE_ENV=production warns if it's left unset or if an
# entry doesn't parse as a bare origin. # production only
TUEZDAY_DB=
PORT=
HOST=
WEB_ORIGIN=

# Scoped background worker credential. Set the same secret on the API and
# worker processes. It can call only /internal/* routes; it is not a general
# system/session credential.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TUEZDAY_WORKER_TOKEN=
# Worker-to-API origin. Production must be HTTPS; loopback HTTP is accepted for
# local development. This is separate from the browser/MCP TUEZDAY_API_URL.
TUEZDAY_INTERNAL_API_URL=http://localhost:3001

# API-owned durable scheduling. The worker does not parse these domain
# intervals. Defaults are shown below. Minute intervals accept 1-1440,
# LEARNING_SYNTHESIS_DAYS accepts 1-365, and ADS_SYNC_HOURS accepts 1-168.
# Invalid values stop the API before any schedules are admitted.
DISCOVERY_INTERVAL_MIN=30
AUTOMATION_INTERVAL_MIN=5
PIPELINES_INTERVAL_MIN=2
PREFERENCES_INTERVAL_MIN=10
LEARNING_SYNTHESIS_DAYS=7
ADS_SYNC_HOURS=6
PUBLISH_INTERVAL_MIN=1
CADENCE_FILL_INTERVAL_MIN=5
INBOX_INTERVAL_MIN=5
MAILBOX_INBOX_INTERVAL_MIN=5
OUTREACH_INTERVAL_MIN=5
SEQUENCE_INTERVAL_MIN=5
EVIDENCE_SWEEP_MIN=30

# Durable queue execution policy (Sprint 73). The worker reads only POLL_MS and
# polls one internal endpoint; the API parses every value and owns admission,
# fair claims, leases, retries and dead letters.
# Poll: 250-60000 ms; batch/per-workspace: 1-100, with per-workspace <= batch.
BACKGROUND_JOB_POLL_MS=1000
BACKGROUND_JOB_BATCH_SIZE=4
BACKGROUND_JOB_PER_WORKSPACE=1
# Lease: 15000-3600000 ms; heartbeat: 1000-60000 ms and heartbeat * 2 < lease.
BACKGROUND_JOB_LEASE_MS=300000
BACKGROUND_JOB_HEARTBEAT_MS=30000
# Attempts: 1-25. Backoff: 100-3600000 ms; max: 100-604800000 ms.
BACKGROUND_JOB_MAX_ATTEMPTS=5
BACKGROUND_JOB_BACKOFF_MS=5000
BACKGROUND_JOB_MAX_BACKOFF_MS=3600000

# API-side discovery execution policy. Defaults are shown; every range is
# inclusive. Millisecond values must be whole integers. Source and matching
# timeouts must stay below the tick timeout, and heartbeat * 2 must stay below
# the lease duration.
# Jobs per tick: 1-25
DISCOVERY_TICK_MAX_JOBS=5
# Whole tick: 10000-600000 ms
DISCOVERY_TICK_TIMEOUT_MS=180000
# One source: 5000-180000 ms
DISCOVERY_SOURCE_TIMEOUT_MS=60000
# Per source: 1-500 items, 1-20 pages, 1-100 provider calls
DISCOVERY_SOURCE_MAX_ITEMS=100
DISCOVERY_SOURCE_MAX_PAGES=4
DISCOVERY_SOURCE_MAX_CALLS=20
# Per provider response: 65536-8388608 bytes
DISCOVERY_RESPONSE_MAX_BYTES=2097152
# Across one source: 262144-33554432 bytes
DISCOVERY_SOURCE_MAX_BYTES=10485760
# Matching per tick: 1-100 items; timeout 5000-120000 ms
DISCOVERY_MATCH_MAX_ITEMS=20
DISCOVERY_MATCH_TIMEOUT_MS=45000
# Leases: 15000-300000 ms; heartbeat: 2000-60000 ms
DISCOVERY_LEASE_MS=45000
DISCOVERY_HEARTBEAT_MS=10000

# Safe outbound URL policy (Sprint 48). HTTPS is always allowed; plain HTTP
# remains off unless the deployment operator explicitly opts in.
TUEZDAY_SAFE_FETCH_ALLOW_HTTP=false

# The API origin the browser calls for every request (apps/web/lib/api.ts).
# Defaults to http://localhost:3001 only when this line is entirely absent —
# fine for local dev where the API happens to run on the same machine as the
# browser. NEXT_PUBLIC_* vars are inlined into the JS bundle at web build
# time, not read at runtime, so leaving this *line present but blank* (as it
# is below, and as a Docker env_file leaves an unfilled var) bakes in an
# empty string rather than the localhost default. Browser fetches then go to
# a *relative* path against the web app's own origin instead of the API —
# calls fail (usually a 404 from the web server, not a network error), with
# no build error and nothing in server logs. Set this to the API's public
# origin, e.g. https://api.<domain>, before building the production web
# image. Changing it requires rebuilding the web image, not just restarting
# the container.
NEXT_PUBLIC_API_URL=

# Product analytics (Sprint 35): PostHog. The API backend key (POSTHOG_API_KEY)
# and the web client key (NEXT_PUBLIC_POSTHOG_KEY) should typically be the same
# project key. POSTHOG_HOST is optional (defaults to US cloud).
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# Web-side counterpart to POSTHOG_HOST above — the PostHog ingestion host the
# browser SDK talks to (apps/web/src/analytics/index.ts). Keep it in sync with
# POSTHOG_HOST if you're self-hosting or on an EU/regional PostHog instance;
# both independently default to the US cloud host when unset.
# NEXT_PUBLIC_* vars are inlined into the JS bundle at web build time, not
# read at runtime — changing this requires rebuilding the web image, not just
# restarting the container.
NEXT_PUBLIC_POSTHOG_HOST=

# Onboarding setup-skip escape hatch: when exactly "true", shows a "Skip setup
# for now" button on /onboarding that jumps straight to a default workspace
# instead of completing the wizard (apps/web/app/onboarding/page.tsx). Any
# other value, including unset, leaves it off — intended for local dev/demo,
# not production. Same build-time-inlining caveat as the NEXT_PUBLIC_POSTHOG_*
# vars above: this is baked into the JS bundle at web build time, not read at
# runtime, so flipping it requires rebuilding the web image.
NEXT_PUBLIC_ENABLE_SETUP_SKIP=

# Billing & Stripe (Sprint 37): Add these vars for checkout and webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
# Each paid plan resolves its Stripe price ID dynamically by name
# (PLANS[planId].priceEnv in packages/contracts) — Pro reads STRIPE_PRICE_PRO
# above, Scale reads this one. Leaving one unset doesn't fail at boot; it
# fails only when a workspace tries to check out into that specific plan.
STRIPE_PRICE_SCALE=
# Entitlement gating switch. Defaults on (any value other than the literal
# string "false" enforces plan limits); set to false to relax enforcement,
# e.g. for local dev with no Stripe keys configured.
BILLING_ENFORCED=

# Notifications & Approvals (Sprint 39): Telegram bot and action tokens.
# TELEGRAM_BOT_TOKEN: Create a bot via @BotFather on Telegram.
# NOTIFY_SIGNING_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# APP_BASE_URL: For public approve/reject links and telegram webhooks.
TELEGRAM_BOT_TOKEN=
NOTIFY_SIGNING_SECRET=
APP_BASE_URL=http://localhost:3000

# Outreach open/click tracking (Sprint 50): the base URL that serves the open
# pixel and click redirects (GET /t/o/:token, /t/c/:token). Use a dedicated
# subdomain for deliverability; falls back to APP_BASE_URL when unset.
TRACKING_BASE_URL=

# Native outbound email sending (Sprint 51): Tuezday owns the send path from
# a verified Resend sender domain — Smartlead/Instantly-style tools are an
# optional manual CSV export only, never a send route. See
# docs/deliverability-posture.md.
# RESEND_API_KEY + MAIL_FROM: both required together, or createDefaultMailer
# falls back to logging mail to the console instead of sending it.
# RESEND_WEBHOOK_SECRET: verifies signatures on delivery callbacks at
# POST /webhooks/resend (bounce/complaint/delivered events); get it from the
# Resend webhook's signing secret. # production only
# EMAIL_UNSUBSCRIBE_SECRET: signs the unsubscribe token in GET/POST /u/:token
# links. Required for every mailbox send, unconditionally — not just sends
# with an unsubscribe footer; without it, every send is blocked. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM=
EMAIL_UNSUBSCRIBE_SECRET=

# MCP Server (Sprint 40): API URL and API key to connect to the main API.
TUEZDAY_API_URL=http://localhost:3000/api/v1
TUEZDAY_API_KEY=

# Design layer (Sprint 41 Part 3): self-hosted Open Design daemon (template
# authoring only — never on the per-post render path). Bring it up with
# `npm run opendesign:up`; OPEN_DESIGN_API_TOKEN below must match the daemon's.
OPEN_DESIGN_BASE_URL=http://localhost:7456
OPEN_DESIGN_API_TOKEN=
# S3-compatible asset storage (R2/B2/S3/MinIO) for rendered slide/ad PNGs —
# Instagram and Meta need publicly fetchable URLs.
ASSET_STORAGE_ENDPOINT=
ASSET_STORAGE_BUCKET=
ASSET_STORAGE_ACCESS_KEY=
ASSET_STORAGE_SECRET_KEY=
ASSET_STORAGE_PUBLIC_BASE_URL=
# Optional; SigV4 region, defaults to "auto" (fine for R2/MinIO).
ASSET_STORAGE_REGION=

# Isolated deterministic renderer (Sprint 75). Set the same dedicated token on
# the API and renderer processes; never reuse the worker or user/API tokens.
# Production must use an internal HTTPS origin. Loopback HTTP is accepted for
# local development, where `npm run dev` starts the renderer on port 7457.
TUEZDAY_RENDERER_URL=http://127.0.0.1:7457
TUEZDAY_RENDERER_TOKEN=
# API transport timeout. Keep it above the renderer's own timeout.
TUEZDAY_RENDERER_TIMEOUT_MS=20000
# Renderer process controls: 1-32 concurrent pages; 1000-120000 ms per render.
RENDER_MAX_CONCURRENCY=2
RENDER_TIMEOUT_MS=15000
# Optional bind address for the renderer process; defaults to loopback.
# RENDER_HOST=127.0.0.1
